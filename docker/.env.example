# Copy to docker/.env and fill in. Never commit the real file.
POSTGRES_PASSWORD=
# A long random string: `python3 -c "import secrets; print(secrets.token_urlsafe(48))"`
# It encrypts device comm keys; changing it later means re-entering them.
CHRONICLE_SECRET_KEY=
CHRONICLE_TIMEZONE=Asia/Tehran
# false only when testing over plain http
CHRONICLE_COOKIE_SECURE=true
CHRONICLE_PORT=8000
