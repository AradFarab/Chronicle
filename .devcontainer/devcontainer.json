{
  "name": "hozur (Frappe v16)",
  "dockerComposeFile": "../docker/dev/compose.yml",
  "service": "frappe",
  "workspaceFolder": "/workspace/hozur",
  "remoteUser": "frappe",
  "shutdownAction": "stopCompose",
  "postCreateCommand": "bash /workspace/hozur/docker/dev/bootstrap.sh",
  "forwardPorts": [8000, 9000, 8080],
  "portsAttributes": {
    "8000": { "label": "Frappe web", "onAutoForward": "notify" },
    "9000": { "label": "Frappe realtime", "onAutoForward": "silent" },
    "8080": { "label": "Vite (frontend)", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "vue.volar",
        "esbenp.prettier-vscode",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-mysql"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/home/frappe/frappe-bench/env/bin/python",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
